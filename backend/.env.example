# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL="postgresql://usuario:senha@postgres:5432/procon_db?schema=public"
PORT=3000

# Gerar uma vez com npm run privacy:setup. NÃO substituir as chaves de uma base já criptografada.
# Valores: base64 de 32 bytes aleatórios, independentes. Não commitar nem compartilhar com o LLM.
DATA_ENCRYPTION_KEY=""
DATA_LOOKUP_KEY=""
# Limpeza desativada: prazos dependem de aprovação do PROCON.
RETENTION_SESSION_DAYS=""
RETENTION_APPOINTMENT_DAYS=""
RETENTION_APPROVED=false
# Integração usa TEST_DATABASE_URL exportada no terminal; prefira o compose.tests.yml.
# O runner não carrega este .env nem permite a base da aplicação como destino de testes.

# Origens exatas do painel. Obrigatório e HTTPS quando NODE_ENV=production.
PANEL_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# O primeiro ADMIN usa npm run auth:setup (senha solicitada no terminal).
# Depois disso, contas são gerenciadas na seção Usuários do painel.
# Para automatizar a configuração inicial, injete AUTH_BOOTSTRAP_USERNAME/PASSWORD por secret, sem commitar.

# Configurações da Meta API
META_WA_TOKEN="meta_wa_token_aqui" # Token de acesso da Meta API
META_PHONE_NUMBER_ID="meta_phone_number_id" # ID do número de telefone do WhatsApp Business
META_VERIFY_TOKEN="meta_verify_token" # Token de verificação do Webhook
META_APP_SECRET="meta_app_secret" # Segredo do aplicativo Meta: valida X-Hub-Signature-256 dos POSTs
META_GRAPH_VERSION=v25.0
TRUST_PROXY=

# Confgurações do Ollama
OLLAMA_EMBED_URL="http://localhost:11434/api/embeddings" # URL do endpoint de embeddings do Ollama
OLLAMA_GENERATE_URL="http://localhost:11434/api/generate" # URL do endpoint de geração de texto do Ollama
OLLAMA_EMBEDDING_MODEL_NAME="bge-m3:latest" # Nome do modelo de embedding a ser utilizado
OLLAMA_GENERATE_MODEL_NAME="gemma3:12b" # Nome do modelo de geração de texto a ser utilizado

# Configurações do LLM
LLM_ENABLE_THINKING=false # Habilita o recurso de "thinking" do LLM

# Informações fixas do Procon que serão mostradas nas respostas do bot
PROCON_HORARIO="Consulte pelo telefone (12) 3955-9130"
PROCON_ENDERECO="Rua Capitão Joaquim Pinheiro do Prado, 222, Centro, Jacareí-SP"
