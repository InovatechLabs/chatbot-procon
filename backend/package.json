{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "messages:queue": "tsx scripts/message-queue.ts",
    "test:states:live": "tsx scripts/smoke-conversation-live.ts",
    "test:legal:live": "tsx scripts/smoke-legal-context-live.ts",
    "test:legal:expanded": "tsx scripts/eval-legal-safety-live.ts",
    "test:legal:replay": "tsx scripts/replay-legal-safety.ts",
    "test:retrieval": "tsx tests/llm/run-retrieval-eval.ts",
    "test:retrieval:replay": "tsx tests/llm/replay-retrieval-eval.ts",
    "test:safety:replay": "tsx tests/llm/replay-output-claims.ts",
    "test": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:coverage": "c8 --reports-dir coverage/unit --temp-directory .ci-generated/coverage-unit node scripts/run-tests.mjs unit",
    "test:coverage:integration": "c8 --reports-dir coverage/integration --temp-directory .ci-generated/coverage-integration node scripts/run-tests.mjs integration",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm test",
    "test:webhook": "node --import tsx --test --test-concurrency=1 tests/webhook/*.test.ts",
    "privacy:backup": "tsx scripts/backup-before-privacy.ts",
    "privacy:verify-backup": "tsx scripts/verify-private-backup.ts",
    "privacy:setup": "tsx scripts/setup-privacy.ts",
    "privacy:migrate": "tsx scripts/migrate-personal-data.ts",
    "privacy:retention": "tsx scripts/retention.ts",
    "test:privacy": "node --import tsx --test --test-concurrency=1 tests/privacy/*.test.ts",
    "auth:setup": "tsx scripts/create-panel-user.ts",
    "test:auth": "node --import tsx --test --test-concurrency=1 tests/auth/*.test.ts",
    "auth:create-user": "tsx scripts/create-panel-user.ts",
    "test:ux": "node --import tsx --test tests/ux/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.mjs",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
