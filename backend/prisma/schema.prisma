generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// Contas administrativas são independentes das sessões dos consumidores.
model PanelUser {
  displayName String?
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String
  role         String         @default("ATTENDANT")
  active       Boolean        @default(true)
  mustChangePassword Boolean   @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     PanelSession[]
}

model PanelSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  user      PanelUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model PanelLoginAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum AppointmentStatus {
  PENDING   // Agendado / Pendente
  COMPLETED // Atendimento Concluído
  CANCELLED // Cancelado
  NO_SHOW   // Não Compareceu
}

model MessageReceipt {
  id String @id @default(uuid())
  sequence BigInt @unique @default(autoincrement())
  metaMessageId String @unique
  phoneNumber String
  phoneLookup String?
  payload String?
  state String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  createdAt DateTime @default(now())
  processedAt DateTime?
  sourceAt DateTime?
  leaseToken String?
  leaseUntil DateTime?
  lastError String?
  outgoing OutgoingMessage[]
  @@index([state, availableAt])
  @@index([state, leaseUntil])
  @@index([leaseToken])
  @@index([phoneLookup, sequence])
  @@index([phoneLookup, sourceAt])
}

model OutgoingMessage {
  id String @id @default(uuid())
  sequence BigInt @unique @default(autoincrement())
  receiptId String?
  receipt MessageReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  phoneNumber String
  phoneLookup String?
  payload String?
  state String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  createdAt DateTime @default(now())
  sentAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  metaMessageId String? @unique
  deliveryStatus String?
  lastError String?
  humanReply ChatLog?
  humanAuthored Boolean @default(false)
  handoffVersion Int?
  @@index([state, availableAt])
  @@index([phoneLookup, sequence])
}

model HumanHandoff {
  phoneLookup String @id
  id String @unique @default(uuid())
  requestedAt DateTime @default(now())
  status String @default("WAITING")
  assigneeId String?
  version Int @default(1)
  @@index([status, requestedAt])
}

model HandoffSettings {
  id            String   @id
  version       Int
  enabled       Boolean
  periods       Json
  queueMessage  String
  closedMessage String
  updatedAt     DateTime @updatedAt
}

model AiSettings {
  id              String   @id
  model           String
  thinkingEnabled Boolean
  version         Int
  updatedAt       DateTime @updatedAt
}

model InstitutionSettings {
  id                 String   @id
  version            Int
  updatedAt          DateTime @updatedAt
  name               String
  address            String
  phone              String
  email              String
  hours              String
  referralMessage    String
  appointmentMessage String
  unavailableMessage String
  rescheduleMessage  String
  privacyMessage     String
  queueMessage       String
}

model RetentionSettings {
  id String @id @default("main")
  sessionsDays Int?
  appointmentsDays Int?
  receiptsDays Int?
  outgoingDays Int?
  approved Boolean @default(false)
  version Int @default(1)
  updatedAt DateTime @updatedAt
  updatedBy String?
  lastRunAt DateTime?
  lastRunVersion Int?
  lastRunCounts Json?
}

model ScheduleSettings {
  id String @id @default("main")
  capacity Int @default(1)
  startMinute Int @default(540)
  endMinute Int @default(1020)
  slotMinutes Int @default(30)
  minLeadMinutes Int @default(60)
  workDays Int[] @default([1, 2, 3, 4, 5])
  version Int @default(1)
  updatedAt DateTime @updatedAt
}

model ConversationEvent {
  id String @id @default(uuid())
  dedupKey String @unique
  kind String
  sessionId String?
  stepId String?
  optionId String?
  categoryKey String?
  stage String?
  answerKind String?
  rating Int?
  source String @default("WHATSAPP")
  occurredAt DateTime @default(now())
  @@index([occurredAt, kind])
  @@index([sessionId, occurredAt])
}

model ScheduleCapacity {
  id String @id @default(uuid())
  date String
  minute Int @default(-1) // -1 = todos os horários do dia; demais = minuto civil
  capacity Int
  @@unique([date, minute])
}

model ScheduleBlock {
  id String @id @default(uuid())
  startDate String?
  endDate String?
  weekDays Int[] @default([]) // vazio = todos os dias do intervalo
  startMinute Int? // ambos nulos = dia inteiro
  endMinute Int?
  note String?
  createdAt DateTime @default(now())
}

// 1. Etapas do Menu Determinístico do Bot
model Step {
  id          String   @id @default(uuid())
  title       String
  message     String
  isStart     Boolean  @default(false)

  options        Option[]      @relation("StepToOptions")
  targetedBy     Option[]      @relation("OptionToNextStep")
  activeSessions UserSession[]
  chatLogs       ChatLog[]
}

// 2. Alternativas do Menu
model Option {
  id         String  @id @default(uuid())
  stepId     String
  text       String
  nextStepId String?

  step     Step  @relation("StepToOptions", fields: [stepId], references: [id])
  nextStep Step? @relation("OptionToNextStep", fields: [nextStepId], references: [id])
}

// 3. Sessão do Usuário
model UserSession {
  phoneLookup String?
  cpfLookup String?
  id            String   @id @default(uuid())
  phoneNumber   String   // Permite múltiplas sessões históricas por número (isolamento de RAG)
  userName      String?
  userCpf       String?
  isChat        Boolean  @default(false)
  status        String   @default("OPEN")
  currentStepId String?
  stepState     String?
  rating        Int?     // Avaliação dada pelo cidadão
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  currentStep  Step?             @relation(fields: [currentStepId], references: [id])
  chatLogs     ChatLog[]
  appointments Appointment[]
  feedbacks    SessionFeedback[]
  @@index([phoneLookup, status, createdAt])
  @@index([cpfLookup])
}

// 4. Logs de Conversa
model ChatLog {
  phoneLookup String?
  id          String   @id @default(uuid())
  sessionId   String
  phoneNumber String
  direction   String   // "INBOUND" ou "OUTBOUND"
  messageText String
  audioMediaId String?
  authorId    String?
  outgoingId  String? @unique
  outgoing    OutgoingMessage? @relation(fields: [outgoingId], references: [id], onDelete: SetNull)
  requestKey  String? @unique
  timestamp   DateTime @default(now())

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepId  String?
  step    Step?       @relation(fields: [stepId], references: [id])
  @@index([phoneLookup, timestamp, id])
}

// 5. Base de Conhecimento RAG
model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String
  content   String
  keywords  String[]
  distincao String?

  embedding Unsupported("vector(1024)")?
}

// 6. Guia de Documentos Obrigatórios
model DocumentGuide {
  id           String   @id @default(uuid())
  categoryKey  String   @unique
  categoryName String
  requiredDocs String[]
  observations String?

  appointments Appointment[]
}

// 7. Atendentes do PROCON (Painel Admin)
model Attendant {
  id        String   @id @default(uuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  appointments Appointment[]
}

// 8. Tabela de Agendamentos Presenciais (Unificada Bot + Painel Admin)
model Appointment {
  phoneLookup String?
  cpfLookup String?
  id              String            @id @default(uuid())
  phoneNumber     String            // Formato DDI (ex: 5512999999999)
  userName        String?           // Nome do cidadão
  userCpf         String?           // CPF validado
  citizenName     String?           // Alias para compatibilidade com o Painel Admin
  subject         String?           // Categoria/Assunto
  categoryName    String?           // Categoria legível
  issueSummary    String?           // Resumo do relato
  notes           String?           // Observações internas do atendente
  scheduledAt     DateTime          // Data e hora marcada em UTC
  durationMin     Int               @default(30)
  status          AppointmentStatus @default(PENDING)
  source          String            @default("WHATSAPP") // "WHATSAPP" ou "PANEL"
  
  sessionId       String?
  documentGuideId String?
  attendantId     String?
  agentNotes      String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  session       UserSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  documentGuide DocumentGuide? @relation(fields: [documentGuideId], references: [id])
  attendant     Attendant?     @relation(fields: [attendantId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([phoneLookup])
  @@index([cpfLookup])
  @@index([attendantId, scheduledAt])
}

// 9. Pesquisa de Satisfação
model SessionFeedback {
  phoneLookup String?
  id              String   @id @default(uuid())
  sessionId       String
  phoneNumber     String
  rating          Int
  comment         String?
  reviewedByAgent Boolean  @default(false)
  agentFeedback   String?
  resolvedAction  String?
  createdAt       DateTime @default(now())

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
