generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum AppointmentStatus {
  PENDING   // Agendado / Pendente
  COMPLETED // Atendimento Concluído
  CANCELLED // Cancelado
  NO_SHOW   // Não Compareceu
}

// 1. Etapas do Menu Determinístico do Bot
model Step {
  id          String   @id @default(uuid())
  title       String
  message     String
  isStart     Boolean  @default(false)

  options        Option[]      @relation("StepToOptions")
  targetedBy     Option[]      @relation("OptionToNextStep")
  activeSessions UserSession[]
  chatLogs       ChatLog[]
}

// 2. Alternativas do Menu
model Option {
  id         String  @id @default(uuid())
  stepId     String
  text       String
  nextStepId String?

  step     Step  @relation("StepToOptions", fields: [stepId], references: [id])
  nextStep Step? @relation("OptionToNextStep", fields: [nextStepId], references: [id])
}

// 3. Sessão do Usuário
model UserSession {
  id            String   @id @default(uuid())
  phoneNumber   String   // Permite múltiplas sessões históricas por número (isolamento de RAG)
  userName      String?
  userCpf       String?
  isChat        Boolean  @default(false)
  status        String   @default("OPEN")
  currentStepId String?
  stepState     String?
  rating        Int?     // Avaliação dada pelo cidadão
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  currentStep  Step?             @relation(fields: [currentStepId], references: [id])
  chatLogs     ChatLog[]
  appointments Appointment[]
  feedbacks    SessionFeedback[]
}

// 4. Logs de Conversa
model ChatLog {
  id          String   @id @default(uuid())
  sessionId   String
  phoneNumber String
  direction   String   // "INBOUND" ou "OUTBOUND"
  messageText String
  timestamp   DateTime @default(now())

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepId  String?
  step    Step?       @relation(fields: [stepId], references: [id])
}

// 5. Base de Conhecimento RAG
model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String
  content   String
  keywords  String[]
  distincao String?

  embedding Unsupported("vector(1024)")?
}

// 6. Guia de Documentos Obrigatórios
model DocumentGuide {
  id           String   @id @default(uuid())
  categoryKey  String   @unique
  categoryName String
  requiredDocs String[]
  observations String?

  appointments Appointment[]
}

// 7. Atendentes do PROCON (Painel Admin)
model Attendant {
  id        String   @id @default(uuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  appointments Appointment[]
}

// 8. Tabela de Agendamentos Presenciais (Unificada Bot + Painel Admin)
model Appointment {
  id              String            @id @default(uuid())
  phoneNumber     String            // Formato DDI (ex: 5512999999999)
  userName        String?           // Nome do cidadão
  userCpf         String?           // CPF validado
  citizenName     String?           // Alias para compatibilidade com o Painel Admin
  subject         String?           // Categoria/Assunto
  categoryName    String?           // Categoria legível
  issueSummary    String?           // Resumo do relato
  notes           String?           // Observações internas do atendente
  scheduledAt     DateTime          // Data e hora marcada em UTC
  durationMin     Int               @default(30)
  status          AppointmentStatus @default(PENDING)
  source          String            @default("WHATSAPP") // "WHATSAPP" ou "PANEL"
  
  sessionId       String?
  documentGuideId String?
  attendantId     String?
  agentNotes      String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  session       UserSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  documentGuide DocumentGuide? @relation(fields: [documentGuideId], references: [id])
  attendant     Attendant?     @relation(fields: [attendantId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([phoneNumber])
  @@index([attendantId, scheduledAt])
}

// 9. Pesquisa de Satisfação
model SessionFeedback {
  id              String   @id @default(uuid())
  sessionId       String
  phoneNumber     String
  rating          Int
  comment         String?
  reviewedByAgent Boolean  @default(false)
  agentFeedback   String?
  resolvedAction  String?
  createdAt       DateTime @default(now())

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}