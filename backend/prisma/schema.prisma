// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}

// 1. A Etapa/Pergunta (O que o bot fala)
model Step {
  id          String   @id @default(uuid())
  title       String   // Nome interno pro Painel Web (Ex: "Menu Principal")
  message     String   // O texto que vai pro WhatsApp 
  isStart     Boolean  @default(false) // Define se é a primeira mensagem que o bot manda quando recebemos uma msg

  // Relacionamentos
  options         Option[] @relation("StepToOptions") // As opçoes de resposta dessa etapa
  targetedBy      Option[] @relation("OptionToNextStep") // Quais opçoes de outras etapas apontam para cá
  activeSessions  UserSession[] // Pessoas que estao paradas lendo essa etapa agora
  chatLogs        ChatLog[]
}

// 2. Alternativas
model Option {
  id          String   @id @default(uuid())
  stepId      String   // A qual Etapa essa opçao pertence
  text        String   // O que o usuario tem que digitar 
  nextStepId  String?  // Para qual Etapa o bot deve mandar o usuario se ele escolher isso

  // Relacionamentos
  step        Step     @relation("StepToOptions", fields: [stepId], references: [id])
  nextStep    Step?    @relation("OptionToNextStep", fields: [nextStepId], references: [id])
}

// 3. Memoria do Bot (Sessao do Usuario)
model UserSession {
  id             String   @id @default(uuid())
  phoneNumber    String   @unique // O número do usuario 
  currentStepId  String?  // Em qual etapa do fluxo ele está
  updatedAt      DateTime @updatedAt // Para saber se a janela de 24h expirou

  isChat         Boolean  @default(false) // Para saber se o usuario está em conversa livre ou navegando pelo menu
  rating         Int?     // Avaliaçao da qualidade das respostas que será usada para treinar o modelo
  status         String   @default("OPEN") // Status do caso, OPEN, RESOLVED ou CLOSED

  // Relacionamentos
  currentStep    Step?    @relation(fields: [currentStepId], references: [id])
  chatLogs       ChatLog[] // Historico atrelado a essa sessao especifica
  appointments   Appointment[] // Atendimentos presenciais agendados por este usuario
}

// Modelo para usar futuramente (aprendizado do bot)
model ChatLog {
  id           String   @id @default(uuid())
  sessionId    String   // Vínculo da sessao de chat
  phoneNumber  String   // Quem enviou
  direction    String   // "INBOUND" (usuário enviou) ou "OUTBOUND" (bot enviou)
  messageText  String   // O texto exato da mensagem
  timestamp    DateTime @default(now())

  session      UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  // Relacionar com o Step para a IA saber em qual contexto o usuário falou isso
  stepId       String?
  step         Step?    @relation(fields: [stepId], references: [id])
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String 
  content   String   
  keywords  String[]
  distincao String?
  
  embedding Unsupported("vector(1024)")? 
}

// ============================================================
// AGENDAMENTO DE ATENDIMENTO PRESENCIAL
// ============================================================

enum AppointmentStatus {
  PENDING    // agendado, ainda nao realizado
  COMPLETED  // cidadao foi atendido
  CANCELLED  // cancelado (libera o horario)
}

// Atendente presencial (opcional: sem nenhum cadastrado, cada horario comporta 1 atendimento)
model Attendant {
  id        String   @id @default(uuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  appointments Appointment[]
}

model Appointment {
  id          String            @id @default(uuid())
  phoneNumber String            // Mesma chave de UserSession/ChatLog (somente digitos, ex: 5511999999999)
  citizenName String?
  subject     String?
  notes       String?
  scheduledAt DateTime          // Sempre em UTC; a grade de horarios usa America/Sao_Paulo
  durationMin Int               @default(30)
  status      AppointmentStatus @default(PENDING)
  source      String            @default("PANEL") // PANEL (painel admin) ou WHATSAPP (agendado pelo bot)
  attendantId String?
  sessionId   String?           // Atalho para a sessao do WhatsApp (null se o cidadao nunca falou com o bot)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  attendant Attendant?   @relation(fields: [attendantId], references: [id], onDelete: SetNull)
  session   UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([phoneNumber])
  @@index([attendantId, scheduledAt])
}
