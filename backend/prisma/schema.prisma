// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}

enum AppointmentStatus {
  SCHEDULED   // Agendado
  COMPLETED   // Compareceu / Atendido
  CANCELLED   // Cancelado pelo usuário ou agente
  NO_SHOW     // Falta (não compareceu)
}

// 1. A Etapa/Pergunta (O que o bot fala)
model Step {
  id          String   @id @default(uuid())
  title       String   // Nome interno pro Painel Web (Ex: "Menu Principal")
  message     String   // O texto que vai pro WhatsApp 
  isStart     Boolean  @default(false) // Define se é a primeira mensagem que o bot manda quando recebemos uma msg

  // Relacionamentos
  options         Option[] @relation("StepToOptions") // As opçoes de resposta dessa etapa
  targetedBy      Option[] @relation("OptionToNextStep") // Quais opçoes de outras etapas apontam para cá
  activeSessions  UserSession[] // Pessoas que estao paradas lendo essa etapa agora
  chatLogs        ChatLog[]
}

// 2. Alternativas
model Option {
  id          String   @id @default(uuid())
  stepId      String   // A qual Etapa essa opçao pertence
  text        String   // O que o usuario tem que digitar 
  nextStepId  String?  // Para qual Etapa o bot deve mandar o usuario se ele escolher isso

  // Relacionamentos
  step        Step     @relation("StepToOptions", fields: [stepId], references: [id])
  nextStep    Step?    @relation("OptionToNextStep", fields: [nextStepId], references: [id])
}

// 3. Memoria do Bot (Sessao do Usuario)
model UserSession {
  id            String            @id @default(uuid())
  phoneNumber   String            // Removido o @unique para permitir múltiplas sessões históricas
  userName      String?
  userCpf       String?
  isChat        Boolean           @default(false)
  status        String            @default("OPEN")
  currentStepId String?
  currentStep   Step?             @relation(fields: [currentStepId], references: [id])
  stepState     String?           
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  appointments  Appointment[]
  chatLogs      ChatLog[]
  feedbacks     SessionFeedback[]
}

// Modelo para usar futuramente (aprendizado do bot)
model ChatLog {
  id           String   @id @default(uuid())
  sessionId    String   // Vínculo da sessao de chat
  phoneNumber  String   // Quem enviou
  direction    String   // "INBOUND" (usuário enviou) ou "OUTBOUND" (bot enviou)
  messageText  String   // O texto exato da mensagem
  timestamp    DateTime @default(now())

  session      UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  // Relacionar com o Step para a IA saber em qual contexto o usuário falou isso
  stepId       String?
  step         Step?    @relation(fields: [stepId], references: [id])
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String 
  content   String   
  keywords  String[]
  distincao String?
  
  embedding Unsupported("vector(1024)")? 
}

model DocumentGuide {
  id            String        @id @default(uuid())
  categoryKey   String        @unique // Ex: "CARTAO_SEGURO", "INSS_EMPRESTIMO", "CONTRATO_CANCELAMENTO", "GERAL"
  categoryName  String        // Nome amigável para exibição
  requiredDocs  String[]      // Lista de documentos obrigatórios
  observations  String?       // Avisos específicos (ex: "se usou o dinheiro, só cabe proposta de quitação")

  appointments  Appointment[]
}

// 7. Tabela de Agendamentos Presenciais
model Appointment {
  id               String            @id @default(uuid())
  sessionId        String
  documentGuideId  String?
  
  userName         String            // Nome do cidadão
  userCpf          String            // CPF do cidadão
  phoneNumber      String            // Telefone de contato
  categoryName     String            // Categoria do problema
  issueSummary     String?           // Resumo do problema relato no RAG ou triagem
  
  scheduledAt      DateTime          // Data e hora marcada
  status           AppointmentStatus @default(SCHEDULED)
  agentNotes       String?           // Observações inseridas pelos atendentes do PROCON no Painel

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  session          UserSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  documentGuide    DocumentGuide?    @relation(fields: [documentGuideId], references: [id])
}

// 8. Avaliações do Atendimento (Para painel admin + sistema de aprendizado)
model SessionFeedback {
  id              String      @id @default(uuid())
  sessionId       String
  phoneNumber     String
  rating          Int         // Nota de 1 a 5
  comment         String?     // Comentário opcional do usuário
  
  // Controle para o sistema de aprendizado supervisionado 
  reviewedByAgent Boolean     @default(false) // Se o atendente humano já analisou este atendimento
  agentFeedback   String?     // Análise do agente (ex: "Bot respondeu artigo incorreto, ajustar RAG")
  resolvedAction  String?     // Ação tomada (ex: "Base de conhecimento atualizada", "Prompt ajustado")

  createdAt       DateTime    @default(now())

  session         UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}